generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Status {
  id        String   @id @default(cuid())
  name      String
  color     String
  order     Int
  kind      String   // "ACTIVE" | "DONE" | "CANCELLED"
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  statusId    String
  status      Status    @relation(fields: [statusId], references: [id])
  duration    String    // Duration enum value, see lib/duration.ts
  priority    String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  dueDate     DateTime?
  position    Float
  completedAt DateTime?
  ownerId     String    @default("local")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([statusId, position])
}
